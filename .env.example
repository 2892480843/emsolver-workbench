# Set these in your shell; this file is not automatically loaded.
# Bind to loopback by default. Choose one authentication mode.
EMSOLVER_DATA_DIR=data
EMSOLVER_PORT=8000
EMSOLVER_API_TOKEN=
# JSON file of named subjects, hashed tokens and global_admin flags.
# If configured, named identities take precedence over the shared token.
EMSOLVER_IDENTITIES_FILE=
# Optional license-approved loopback model configuration JSON. Rules work without it.
EMSOLVER_LOCAL_MODEL_CONFIG=
# Restrict server-side local imports to explicitly authorized directories.
EMSOLVER_IMPORT_ROOTS=
